<view class="login-page">
  <view class="login-header">
    <view class="logo-wrap">
      <text class="logo-icon">🎤</text>
    </view>
    <text class="app-title">点歌台</text>
    <text class="app-desc">为你喜爱的歌曲下单</text>
  </view>

  <view class="login-body">
    <view class="profile-form">
      <view class="avatar-section">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="avatar-img" src="{{avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
          <view class="avatar-placeholder" wx:if="{{!avatarUrl}}">
            <text class="avatar-icon">👤</text>
          </view>
          <text class="avatar-tip">选择头像</text>
        </button>
      </view>
      <view class="nickname-section">
        <input class="nickname-input" type="nickname" placeholder="请输入昵称" value="{{nickName}}" bindinput="onNicknameInput" bindblur="onNicknameBlur" />
      </view>
    </view>
    <button class="login-btn primary" bindtap="onConfirmLogin" disabled="{{loading}}" loading="{{loading}}">
      微信授权登录
    </button>
    <button class="login-btn quick" bindtap="onQuickLogin" disabled="{{loading}}">
      快捷登录
    </button>
  </view>

  <view class="login-footer">
    <text class="footer-text">登录即代表同意用户协议和隐私政策</text>
  </view>
</view>
