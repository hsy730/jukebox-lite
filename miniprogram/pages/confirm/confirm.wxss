.page {
  background: #F5F5F5;
  min-height: 100vh;
  padding: 24rpx;
}

.song-detail-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.detail-cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  background: #eee;
}

.detail-info {
  flex: 1;
  overflow: hidden;
}

.detail-name {
  display: block;
  font-size: 34rpx;
  color: #333;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-artist {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}

.detail-album {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
}

.form-title {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.picker-value {
  font-size: 30rpx;
  color: #333;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-value.placeholder {
  color: #ccc;
}

.message-input {
  width: 100%;
  height: 180rpx;
  font-size: 28rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  background: #fafafa;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #ccc;
  margin-top: 8rpx;
}

.price-display {
  display: flex;
  align-items: baseline;
}

.price-number {
  font-size: 48rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.price-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

.submit-area {
  margin-top: 40rpx;
  padding: 0 20rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  border-radius: 50rpx;
  font-size: 34rpx;
  padding: 24rpx 0;
  text-align: center;
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #ccc;
  color: #fff;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
