.page {
  background: #F5F5F5;
  min-height: 100vh;
  padding: 24rpx;
}

.success-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}

.success-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.success-icon {
  font-size: 60rpx;
  color: #fff;
  font-weight: bold;
}

.success-title {
  font-size: 40rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.success-subtitle {
  font-size: 26rpx;
  color: #999;
}

.order-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.order-id {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.order-status.pending {
  background: #FFF3E0;
  color: #FF9800;
}

.order-song {
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.order-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #eee;
}

.order-song-info {
  flex: 1;
  overflow: hidden;
}

.order-song-name {
  display: block;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-song-artist {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.order-detail {
  padding: 0;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 0;
}

.detail-label {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
  text-align: right;
  max-width: 400rpx;
  word-break: break-all;
}

.detail-value.price {
  color: #FF6B6B;
  font-weight: bold;
}

.action-area {
  margin-top: 40rpx;
  padding: 0 20rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  text-align: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
